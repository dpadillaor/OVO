# LaTeX build artifacts. latexmk routes them to build/ via .latexmkrc; the bare
# patterns catch anything a tool writes in-place anyway.
build/
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc

# Guard: a tool ignoring .latexmkrc drops the PDF here. Anchored, so figures/ and images/ PDFs stay tracked.
/main.pdf
