@startuml flujo_decision_contest
title Flujo de decision - Contest (merge/split de instancias)
caption Umbrales: min_mass=50 · high=0.60 low=0.40 · strong(pers>=0.5) · partial(pers>=0.6, excl>=0.8) · focus(>=0.7, excl>=0.9, pers>=0.6) · por-par(firm>=50, excl>=0.8, pers>=0.5)

skinparam defaultFontName Helvetica
skinparam ActivityDiamondBackgroundColor #FFF8E1
skinparam ActivityBackgroundColor #ECEFF1

start
:Defender + sus pares defender->challenger;

if (Algun par total_grabs >= min_mass=50?) then (no)
  #BDBDBD:NO_ACTION\n"ruido (masa baja)";
  stop
else (si)
endif

:Clasificar pares por containment;

' ================= STRONG: cont >= high =================
if (Hay pares cont >= high=0.60?\n(strong)) then (si)
  if (Algun dueño firme?\npers >= 0.5) then (no)
    #BDBDBD:NO_ACTION\n"contenido sin dueño firme";
    stop
  else (si)
    if (roots de dueños firmes == 1?\n(union-find fusion)) then (si, 1 raiz)
      #66BB6A:MERGE_CONTAINMENT\n"fragment contained (cont alta, 1 raiz)";
      stop
    else (no, >=2 raices)
      #BDBDBD:NO_ACTION\n"frontera real (>=2 raices)";
      stop
    endif
  endif
else (no)
endif

' ================= PARTIAL: low <= cont < high =================
if (Hay pares low=0.40 <= cont < 0.60?\n(partial)) then (si)
  if (Algun dueño?\npers >= 0.6  Y  excl >= 0.8) then (no)
    #BDBDBD:NO_ACTION\n"partial sin dueño firme+exclusivo";
    stop
  else (si)
    if (roots de dueños cualificados == 1?) then (si, 1 raiz)
      #66BB6A:MERGE_CONTAINMENT\n"fragmento (pers+excl, 1 raiz)\n[sin descriptor, sin split]";
      stop
    else (no, >=2 raices)
      #BDBDBD:NO_ACTION\n"frontera real (>=2 raices)";
      stop
    endif
  endif
else (no, cont < low)
endif

' ================= SPLIT: cont < low -> lista 0..N =================
partition "SPLIT: retener trozos ajenos (classify -> List[Verdict], 0..N, dedup por challenger)" {
  note right
    Dos bandas COMPLEMENTARIAS, se evaluan
    por CADA challenger de forma independiente:
      FOCUS  = sniper alta precision (<=1 par)
      POR-PAR = las gordas que focus omite (0..N)
    NO se mergea: CLIP no distingue instancias
    de misma clase -> over-merge.
  end note

  fork
    :BANDA FOCUS (por par);
    if (focus >= 0.7\nY excl >= 0.9\nY pers >= 0.6?) then (si)
      #64B5F6:SPLIT "focus"\n(un challenger domina lo disputado;\ncualquier tamaño, rescata trozos limpios chicos);
    else (no)
      #BDBDBD:(no emite);
    endif
  fork again
    :BANDA POR-PAR (por par, si challenger no tomado por focus);
    if (firm_points >= 50\nY excl >= 0.8\nY pers >= 0.5?) then (si)
      #64B5F6:SPLIT "por-par"\n(trozo grande+exclusivo+persistente;\nrescata gordas que focus omite, ej ballena);
    else (no)
      #BDBDBD:(no emite);
    endif
  end fork

  if (Alguna banda emitio algun SPLIT?) then (no)
    #BDBDBD:NO_ACTION\n"borde";
    stop
  else (si)
    :Lista de veredictos SPLIT\n(un defender puede soltar N trozos a N vecinos);
    stop
  endif
}

@enduml
