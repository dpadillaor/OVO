skinparam groupInheritance 2
hide empty members

' ─────────────────────────────────────────────
'  ORCHESTRATION (ovomapping.py)
' ─────────────────────────────────────────────
package "Orchestration" #DDEEFF {

  class OVOSemMap {
    ' Central controller: owns SLAM backbone + OVO semantic module
    + config : Dict
    + device : str
    + dataset_name : str
    + output_path : Path
    + map_every : int
    + segment_every : int
    + track_every : int
    + stream : bool
    + logger : Logger
    + dataset : BaseDataset
    + ovo : OVO
    + slam_backbone : VanillaMapper
    + _fusion_log_path : Path
    --
    + run() : None
    + save_representation() : None
    + restore_representation() : None
    # _run_mapping_and_fusion_step(frame_state, queue) : float
    # _run_semantic_step(frame_state, queue, ...) : float
    # _should_process_frame(frame_id) : bool
    # _should_run_segmentation(frame_id) : bool
    # _write_fusion_decisions(frame_id, decisions) : None
    # _send_stream_frame(frame_id, queue) : None
    # _send_loop_closure_event(frame_id, queue) : None
  }

  class FrameState <<dataclass>> {
    + frame_id : int
    + frame_data : Any
    + estimated_c2w : Tensor
  }
}

' ─────────────────────────────────────────────
'  SEMANTIC PIPELINE (ovo.py)
' ─────────────────────────────────────────────
package "Semantic Pipeline" #DDFFD4 {

  class OVO {
    ' Manages instance lifecycle: segmentation → tracking → fusion → classification
    + config : Dict
    + device : str
    + cam_intrinsics : Tensor
    + fusion_method : str
    + n_top_views : int
    + objects : Dict[int, Instance3D]
    + keyframes : Dict[str, Any]
    + next_ins_id : int
    + clip_generator : CLIPGenerator
    + pe_generator : PEGenerator
    + mask_generator : MaskGenerator
    + sam3_generator : SAM3Generator
    + fusion_strategy : FusionStrategy
    + fusion_encoder : FusionEncoderAdapter
    + th_centroid : float
    + th_cossim : float
    + th_points : float
    --
    + detect_and_track_objects(frame_data, map_data, c2w) : Tensor
    + update_map(map_data, kfs) : None
    + compute_semantic_info() : None
    + complete_semantic_info() : None
    + classify_instances(classes, template, th) : None
    + query(queries, templates, ensemble) : Tensor
    + get_objs_clips() : Tensor
    + capture_dict(debug_info) : Dict
    + restore_dict(scene_dict, debug_info) : None
    + to(device) : None
    + cpu() : None
    + cuda() : None
    # _get_masks(image, frame_id)
    # _match_and_track_instances(frame_data, map_data, c2w, seg_map, binary_maps)
    # _track_objects(...)
    # _fuse_masks_with_same_ins_id(binary_maps, matched_ins_info, kf_id)
    # _fuse_overlapping_instances(objects_list, points_3d, map_data)
    # _compute_fusion_info(image, binary_maps, matched_ins_ids, kf_id)
    # _extract_clip(image, binary_maps)
    # _extract_pe(image, binary_maps)
    # _update_matched_objects_clip(clip_embeds, matched_ins_ids, kf_id)
  }

  class Instance3D {
    ' Per-instance state: point cloud membership, feature descriptors, keyframe refs
    + id : int
    + clip_feature : Tensor
    + pe_feature : Tensor
    + sam3_feature : Tensor
    + dino_feature : Tensor
    + kfs_ids : list
    + points_ids : list
    + top_kf : list
    + to_update : bool
    + to_update_pe : bool
    + to_update_sam3 : bool
    --
    + update(points_ids, kf_id, area) : None
    + add_points_ids(points_ids) : None
    + add_keyframes(kf_id) : None
    + add_top_kf(kf_id, area) : None
    + is_top_kf(kf_id) : bool
    + update_clip(keyframes_clips, force_update) : None
    + update_pe(keyframes_pe, force_update) : None
    + update_sam3(keyframes_sam3, force_update) : None
    + export(debug_info) : Dict
    + restore(obj_dict, debug_info) : None
    + purge_points_ids(purge_ids) : None
  }
}

' ─────────────────────────────────────────────
'  FUSION STRATEGIES (fusion.py)
' ─────────────────────────────────────────────
package "Fusion Strategies" #FFF3CD {

  abstract class FusionStrategy {
    ' Decides whether two instances should be merged
    # _decisions : list
    --
    {abstract} + same_instance(instance1, instance2, points_centroid1, points_centroid2) : bool
    + pop_decisions() : list
  }

  class SemanticGeometricFusion {
    ' Centroid + cosine-similarity + point-cloud overlap
    ' feature_attr selects which descriptor to use (clip/pe/dino/sam3)
    + th_centroid : float
    + th_cossim : float
    + th_points : float
    + feature_attr : str
    --
    + same_instance(...) : bool
  }

  class GeometricOnlyFusion {
    ' Centroid distance + overlap only — no semantic descriptor
    + th_centroid : float
    + th_points : float
    + th_cossim : None
    --
    + same_instance(...) : bool
  }
}

' ─────────────────────────────────────────────
'  FUSION ENCODER ADAPTERS (fusion_encoders.py)
' ─────────────────────────────────────────────
package "Fusion Encoders" #FFE8D6 {

  abstract class FusionEncoderAdapter {
    ' Adapter pattern: uniform API over different feature extractors
    {abstract} + compute_and_update(image, binary_maps, matched_ins_ids, kf_id, keyframes, objects) : None
    {abstract} + update_objects(objects, keyframes) : None
    {abstract} + transfer_on_merge(source_ids, target_id, keyframes) : None
    {abstract} + cleanup_keyframe(kf_id, keyframes) : None
  }

  class PEFusionAdapter {
    + generator : PEGenerator
    + storage_key : str
    --
    + compute_and_update(...) : None
    + update_objects(...) : None
    + transfer_on_merge(...) : None
    + cleanup_keyframe(...) : None
  }

  class DINOFusionAdapter {
    ' Stub — not yet implemented
    + generator : Any
    + storage_key : str
  }

  class SAM3FusionAdapter {
    + generator : SAM3Generator
    + storage_key : str
    --
    + compute_and_update(...) : None
    + update_objects(...) : None
    + transfer_on_merge(...) : None
    + cleanup_keyframe(...) : None
  }
}

' ─────────────────────────────────────────────
'  FEATURE GENERATORS (clip_generator, pe_generator, etc.)
' ─────────────────────────────────────────────
package "Feature Generators" #F0E6FF {

  class CLIPGenerator {
    ' Wraps CLIP/SigLIP; supports vanilla + learned ensemble
    + config : Dict
    + device : str
    + embed_type : str
    + model_card : str
    + clip_dim : int
    --
    + extract_clip(image, binary_maps, return_all) : Tensor
    + get_txt_embedding(text_list) : Tensor
    + get_embed_txt_similarity(ins_descriptors, txt_queries, templates) : Tensor
    + encode_image(input) : Tensor
    + to(device) / cpu() / cuda() : None
  }

  class PEGenerator {
    ' Wraps Perception Encoder (Meta PE-Core)
    + config : Dict
    + device : str
    + model_card : str
    + embed_dim : int
    + is_vision_only : bool
    --
    + extract_pe(image, binary_maps) : Tensor
    + get_txt_embedding(text_list) : Tensor
    + get_embed_txt_similarity(ins_descriptors, txt_queries, templates) : Tensor
    + encode_image(input) : Tensor
    + to(device) / cpu() / cuda() : None
  }

  class SAM3Generator {
    ' Wraps SAM3 ViT trunk (optional neck + text encoder)
    + config : Dict
    + device : str
    + components : str
    + embed_dim : int
    --
    + extract_sam3(image, binary_maps) : Tensor
    + encode_image(input) : Tensor
    + to(device) / cpu() / cuda() : None
  }

  class MaskGenerator {
    ' Wraps SAM for per-frame instance segmentation
    ' Supports precomputed masks (disk cache)
    + config : Dict
    + device : str
    + precomputed : bool
    + nms_iou_th : float
    + nms_score_th : float
    --
    + get_masks(image, frame_id) : Tuple[Tensor, Tensor]
    + precompute(dataset, segment_every) : None
    + segment(image) : Tuple[ndarray, ndarray]
    + to(device) / cpu() / cuda() : None
  }
}

' ─────────────────────────────────────────────
'  SLAM BACKENDS (slam/)
' ─────────────────────────────────────────────
package "SLAM Backends" #F5F5DC {

  class VanillaMapper {
    ' GT-pose point-cloud mapper via depth unprojection
    ' Implicit interface implemented by all backends
    + cam_intrinsics : Tensor
    + config : Dict
    + device : str
    + pcd : Tensor
    + pcd_ids : Tensor
    + pcd_obj_ids : Tensor
    + pcd_colors : Tensor
    + estimated_c2ws : Dict[int, Tensor]
    + kfs : Dict
    + map_updated : bool
    + max_frame_points : float
    + match_distance_th : float
    --
    + track_camera(frame_data) : None
    + map(frame_data, c2w) : None
    + get_c2w(frame_id) : Tensor
    + get_map() : Tuple[Tensor, Tensor, Tensor]
    + get_kfs() : Dict
    + get_map_dict() : Dict
    + set_map_dict(d) : None
    + get_cam_dict() : Dict
    + set_cam_dict(d) : None
    + update_pcd_obj_ids(ids) : None
    + get_pcd_colors() : ndarray
  }

  class GroundTruthSLAM {
    ' Adds noise injection + simulated loop closure + global correction
    + trajectory : list
    + noise_enabled : bool
    + jump_drift_enabled : bool
    + close_loops : bool
    + jump_configs : list
    --
    + track_camera(frame_data) : None
    + map(frame_data, c2w) : None
    + correct_map_globally() : None
    # _noisy_tracking(frame_data) : None
    # _jump_tracking(frame_data) : None
    # _is_new_keyframe(current_c2w) : bool
    # _check_for_loop_closure(kf_id, c2w) : None
  }

  class WrapperORBSLAM2 {
    ' Wraps ORB-SLAM2 via Python bindings
    + close_loops : bool
    + last_big_change_id : int
    + world_ref : Tensor
    + orbslam : orbslam.System
    --
    + track_camera(frame_data) : None
    + map(frame_data, c2w) : None
    + update_map() : None
  }

  class WrapperGaussianSLAM {
    ' Wraps Gaussian-SLAM; duck-type compatible with VanillaMapper interface
    ' Does NOT inherit VanillaMapper
    + device : str
    + config : Dict
    + map_updated : bool
    + gaussian_model : SemGaussianModel
    + mapper : Mapper
    + tracker : Tracker
    --
    + track_camera(frame_data) : None
    + map(frame_data, estimated_c2w) : None
    + get_map() : Tuple[Tensor, Tensor, Tensor]
    + get_map_dict() : Dict
    + get_cam_dict() : Dict
    + update_pcd_obj_ids(ids) : None
    + get_pcd_colors() : ndarray
  }

  class SemGaussianModel {
    ' GaussianModel + per-point instance & unique IDs
    + _obj_ids : Tensor
    + ids : Tensor
    + max_id : int
    --
    + get_ids() : Tensor
    + get_obj_ids() : Tensor
    + set_objs_ids(obj_ids) : None
    + prune_points(mask) : None
    + save_ply(path) : None
    + load_ply(path) : None
    + densification_postfix(...) : None
  }

  class GaussianModel <<external>> {
    ' From thirdParty/gaussian_slam
  }
}

' ─────────────────────────────────────────────
'  DATASETS (datasets.py)
' ─────────────────────────────────────────────
package "Datasets" #E8F4E8 {

  abstract class BaseDataset {
    + dataset_path : Path
    + frame_limit : int
    + height / width : int
    + fx / fy / cx / cy : float
    + fovx / fovy : float
    + intrinsics : ndarray
    + color_paths / depth_paths : list
    + depth_scale : float
    + distortion : ndarray
    --
    + __len__() : int
    {abstract} + __getitem__(index)
  }

  class Replica {
    + poses : list
    --
    + load_poses(path)
    + __getitem__(index)
  }

  class ScanNet {
    + depth_th : float
    --
    + load_poses(path)
    + __getitem__(index)
  }

  class ScanNetPP {
    + use_train_split : bool
    + image_names : list
    + poses : list
    --
    + load_data()
    + __getitem__(index)
  }

  class Matterport {
    --
    + load_poses(path)
    + __getitem__(index)
  }
}

' ─────────────────────────────────────────────
'  LOGGING (logger.py)
' ─────────────────────────────────────────────
package "Logging" #F5F5F5 {

  class Logger {
    + output_path : Path
    + stats : Dict[str, list]
    + use_wandb : bool
    --
    + log_ovo_stats(stats, print_output) : None
    + log_fps(avg_fps) : None
    + log_spf(spf) : None
    + log_total_time(total_time) : None
    + log_memory_usage(frame_id) : None
    + write_stats() : None
    + print_final_stats() : None
  }
}

' ─────────────────────────────────────────────
'  RELATIONSHIPS
' ─────────────────────────────────────────────

' Inheritance — SLAM
VanillaMapper <|-- GroundTruthSLAM
VanillaMapper <|-- WrapperORBSLAM2
GaussianModel <|-- SemGaussianModel
WrapperGaussianSLAM *-- SemGaussianModel : gaussian_model

' Inheritance — Fusion
FusionStrategy <|-- SemanticGeometricFusion
FusionStrategy <|-- GeometricOnlyFusion
FusionEncoderAdapter <|-- PEFusionAdapter
FusionEncoderAdapter <|-- DINOFusionAdapter
FusionEncoderAdapter <|-- SAM3FusionAdapter

' Inheritance — Datasets
BaseDataset <|-- Replica
BaseDataset <|-- ScanNet
BaseDataset <|-- ScanNetPP
BaseDataset <|-- Matterport

' Composition — Orchestrator
OVOSemMap *-- OVO : ovo
OVOSemMap *-- Logger : logger
OVOSemMap o-- BaseDataset : dataset
OVOSemMap o-- VanillaMapper : slam_backbone
OVOSemMap ..> FrameState : creates

' Composition — OVO
OVO *-- FusionStrategy : fusion_strategy
OVO o-- FusionEncoderAdapter : fusion_encoder
OVO *-- CLIPGenerator : clip_generator
OVO o-- PEGenerator : pe_generator
OVO o-- MaskGenerator : mask_generator
OVO o-- SAM3Generator : sam3_generator
OVO "1" *-- "0..*" Instance3D : objects

' Fusion encoder → generators
PEFusionAdapter *-- PEGenerator : generator
SAM3FusionAdapter *-- SAM3Generator : generator

' Feature usage in fusion strategies
SemanticGeometricFusion ..> Instance3D : reads feature_attr

@enduml
