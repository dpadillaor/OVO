@startuml instance_ap_workflow
title Workflow AP (class-aware + class-agnostic) — OVO

skinparam defaultFontName monospaced
skinparam ArrowColor #333
skinparam shadowing false

|#E8F0FE|Batch / Orchestration|
start
:run_experiments_batch.py;
note right
  manifest -> ExperimentRunner
  stages = run / segment / eval
  (+ flag --eval_instances)
end note
:run_eval.py
--run --segment --eval_instances;

|#FFF3E0|Stage: run|
:run_scene()
SLAM + semantica;
:guarda <b>ovo_map.ckpt</b>;

|#E6F4EA|Stage: segment  (run_eval.py:segment_scene)|
:cargar ckpt + reconstruir instancias;
:ovo.classify_instances(classes)
-> classes + conf por instancia;
:eval_utils.match_labels_to_vtx()
proyecta pred PCL -> vertices mesh GT (KD-tree);
:io_utils.write_instances()
escribe instance_pred/{scene}.txt
+ predicted_masks/*.json (RLE);

|#F3E5F5|Stage: eval_instances  (eval_utils.eval_instance_ap)|
:io_utils.load_instance_preds()
lee .txt + RLE
-> pred_masks / pred_classes / pred_scores;

split
  :ins_eval_utils.evaluate(class_agnostic=<b>False</b>);
split again
  :ins_eval_utils.evaluate(class_agnostic=<b>True</b>)\ncolapsa todo a clase "generic";
end split

|#FCE4EC|Nucleo AP  (ins_eval_utils.py — identico al ejemplo)|
:read_gt()
gt_ids -> masks; clase = id // 1000;
:make_pred_info()
empaqueta uuid / conf / mask;
:assign_instances_for_scan()
matching pred<->gt por interseccion de puntos;
:evaluate_matches()
IoU = inter/(gt+pred-inter)
asignacion greedy por conf
curva precision-recall -> AP por clase/overlap;
note right
  overlaps = [0.5..0.9 step .05] + 0.25
  min_region_size = 100 verts
end note
:compute_averages()
mean sobre overlaps
-> all_ap / all_ap_50% / all_ap_25%;

|#F3E5F5|Stage: eval_instances|
:metrics dict
AP / AP_50 / AP_25  (aware)
AP_agnostic / _50 / _25  (agnostic);
:escribe instance_ap.txt
+ instance_ap_{scene}.txt por escena;
stop

@enduml
